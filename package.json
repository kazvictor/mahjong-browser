{
  "name": "mahjong-browser",
  "version": "0.1.0",
  "description": "A browser-based Mahjong game — Canvas 2D tile rendering, CSS + requestAnimationFrame animations, and vanilla TypeScript state management.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test --config tests/visual/playwright.config.ts",
    "test:visual:headed": "playwright test --config tests/visual/playwright.config.ts --headed",
    "test:visual:report": "playwright show-report tests/visual/playwright-report",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"*.{json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "keywords": [
    "mahjong",
    "game",
    "canvas",
    "typescript",
    "browser-game"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
